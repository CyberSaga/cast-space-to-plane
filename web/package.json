{
  "name": "castplane-web",
  "version": "0.1.0",
  "private": true,
  "description": "three.js web UI of the castplane TypeScript port: scene display, camera drag, SVG overlay and downloads (static, no server)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test build/test/*.test.js"
  },
  "dependencies": {
    "castplane": "0.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "6.0.2",
    "vite": "8.3.3"
  }
}
