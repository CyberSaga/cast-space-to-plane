{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["src/orbit.ts", "src/download.ts", "src/mesh3d.ts", "src/helpers3d.ts", "src/rig.ts", "src/equation.ts", "src/observer.ts", "src/plane.ts", "src/toggles.ts", "src/keys.ts", "test"]
}
