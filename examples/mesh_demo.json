    {"id": "ground", "type": "plane", "normal": [0, 0, 1], "offset": 0.0}
  ],
  "camera": {
    "position": [2.6, -5.4, 2.3],
    "target": [0.3, 0.2, 0.55],
    "roll_deg": 0,
    "focal_length_mm": 35,
    "frame_mm": [36, 24],
    "shift_mm": [0.0, 0.0],
    "near_m": 0.05
